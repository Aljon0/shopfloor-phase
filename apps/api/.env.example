# Copy to apps/api/.env and edit. Never commit the real .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://shopfloor:shopfloor@localhost:5432/shopfloor
# At least 32 random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
SESSION_HOURS=10
# true only when the site is served over HTTPS
COOKIE_SECURE=false
# Browser origins allowed to call the API (comma separated). Vite dev server by default.
ALLOWED_ORIGINS=http://localhost:5173
# Password given to the demo users by "npm run db:seed". Development only.
SEED_PASSWORD=ChangeMe-Demo-2026!
# Reverse proxies in front of the API. 0 when you run it directly; the Docker stack sets 1 (nginx).
TRUST_PROXY=0
