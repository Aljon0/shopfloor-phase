# Copy to .env (same folder as docker-compose.yml) and edit. Never share or commit the real .env.

# Database password. Choose your own; letters and digits are safest.
POSTGRES_PASSWORD=change-me-db-password

# Signs sign-in sessions. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# Port people type after the computer's address. 80 means they can omit it.
WEB_PORT=8080

# Exactly what people type in the browser, including http:// and the port (comma separated for several).
# Examples: http://192.168.1.50:8080   or   http://shopfloor.local:8080
ALLOWED_ORIGINS=http://localhost:8080

# Keep false while the site is served over plain http on the LAN. true only behind HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=10

# Password for the demo users created by the one-time seed command. Demo only: change or replace them.
SEED_PASSWORD=ChangeMe-Demo-2026!
